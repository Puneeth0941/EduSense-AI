# EduSense AI Environment Configuration
# Project: EduSense AI – Smart Classroom Attendance and Student Engagement Analytics
# Phase: 1 (Foundation & Architecture Setup)

# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api

# FastAPI Server Settings
HOST=0.0.0.0
PORT=8000

# Security Credentials
# NEVER hardcode production keys or commit real secrets to source control
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=apple
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edusense_db

# Assembled Database URL (SQLAlchemy)
DATABASE_URL=postgresql://apple@localhost:5432/edusense_db

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# LiveKit Real-Time Classroom Configuration (Placeholder for Phase 2+)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Face AI Configuration & Quality Thresholds
FACE_MODEL_PACK=buffalo_sc
FACE_MIN_SIZE=100
FACE_BLUR_THRESHOLD=30.0
FACE_CONSISTENCY_THRESHOLD=0.40
FACE_RECOGNITION_SIMILARITY_THRESHOLD=0.50

